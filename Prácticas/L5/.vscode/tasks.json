{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compile, Upload, and Run on STM32",
            "type": "shell",
            "command": "${CC} ${file} -o ${fileBasenameNoExtension} && scp ${fileBasenameNoExtension} root@192.168.7.1:/root/ && ssh root@192.168.7.1 '/root/${fileBasenameNoExtension}'",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}
